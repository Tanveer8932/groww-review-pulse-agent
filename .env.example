# Groww Review Pulse Agent — environment template.
# Copy to .env (gitignored) and fill in real values. Never commit real values.
# Empty values are treated as "not set".

# ---- Collection --------------------------------------------------------------
APP_ID=com.nextbillion.groww
# Analysis window in weeks; must be 8–12.
ANALYSIS_WINDOW_WEEKS=12
# Reserved; automated collection is rejected (docs/data-source-decision.md). Keep false.
ENABLE_PLAY_COLLECTOR=false

# ---- Preprocessing -----------------------------------------------------------
# Keep reviews with MORE than this many words.
MIN_WORDS_EXCLUSIVE=8
# strict = drop any review containing emoji; lenient = drop emoji-only, never quote the rest.
EMOJI_POLICY=strict
LANG_MIN_CONFIDENCE=0.80
# Keep English below LANG_MIN_CONFIDENCE (but >= 0.50) only when >= 85% of its ordinary
# words are known English words and it has no Hinglish markers. false = threshold only.
LANG_LEXICAL_RESCUE=true

# ---- LLM ---------------------------------------------------------------------
# groq (this project: Groq Cloud free tier) or anthropic (code default; needs ANTHROPIC_API_KEY).
LLM_PROVIDER=groq
# Leave empty for the provider default: openai/gpt-oss-120b (groq) / claude-sonnet-5-5 (anthropic).
# The configured model is the only one ever called; nothing switches to another or paid model.
LLM_MODEL=openai/gpt-oss-120b
# Create at https://console.groq.com/keys (free plan, no card). Never commit it.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Groq free-tier limit for the model (prompt + max output per minute; see console.groq.com/settings/limits).
# Each request is kept under it and requests are paced to stay under it.
GROQ_TOKENS_PER_MINUTE=8000
# Output cap per Groq request (must be below GROQ_TOKENS_PER_MINUTE).
GROQ_MAX_OUTPUT_TOKENS=2500
# Total input + output tokens one analysis run may spend; checked before every call.
# 150000 keeps a run well under Groq's free 200K tokens/day (a 67-review run needs ~30K).
LLM_MAX_TOKENS_PER_RUN=150000
LLM_TIMEOUT_SECONDS=120
# Analysis refuses to run on fewer reviews than this (no pulse from a handful of reviews).
ANALYSIS_MIN_REVIEWS=20

# ---- MCP delivery ------------------------------------------------------------
# Full Streamable-HTTP MCP endpoint. For mcp-server-4 the MCP endpoint is the root path "/"
# (see docs/mcp-contract.md). Example: https://your-mcp-server.example.com/
MCP_SERVER_URL=
# Bearer token for the MCP server. Optional for `check-mcp` and dry runs, but REQUIRED for
# live delivery: `publish --confirm` also verifies that the server rejects clients without
# it (security gate). This is the PLAINTEXT token; the server holds only its SHA-256 hash in
# MCP_AUTH_TOKEN_SHA256 (generate both with `npm run auth:token` in mcp-server-4). Live delivery
# stays blocked until the patched server is deployed (see docs/mcp-server-security.md §5).
MCP_AUTH_TOKEN=
MCP_TIMEOUT_SECONDS=30
# Bare Google Doc ID (the part between /d/ and /edit), NOT the full URL. Use a TEST doc first.
GOOGLE_DOC_ID=
# Comma-separated draft recipients (a draft is created; email is never sent).
PULSE_EMAIL_TO=
# dry_run (default) or confirm. Live delivery needs BOTH DELIVERY_MODE=confirm and the
# `groww-pulse publish --confirm` flag.
DELIVERY_MODE=dry_run

# ---- Storage / ops -----------------------------------------------------------
DATA_DIR=./data
# Read-only dashboard snapshot shown when DATA_DIR has no verified pulse (hosted UI).
# Leave empty to use snapshot/ next to app/ (written by `groww-pulse export-snapshot`).
SNAPSHOT_DIR=
RAW_RETENTION_DAYS=90
LOG_LEVEL=INFO
# json or text
LOG_FORMAT=json
